<?xml version="1.0"?>
<ruleset name="KaosSlider">
	<description>Standard di codice e sicurezza WordPress per KaosSlider.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/branding/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>*.js</exclude-pattern>
	<exclude-pattern>*.css</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Gli avvisi vengono mostrati ma non fanno fallire il controllo: falliscono solo gli errori. -->
	<config name="ignore_warnings_on_exit" value="1"/>

	<config name="minimum_wp_version" value="6.2"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress-Extra">
		<!-- Nomi file "class-*.php" già usati; i file di integrazione e il file principale fanno eccezione. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<!-- Le chiavi degli array sono allineate a mano. -->
		<exclude name="WordPress.Arrays.MultipleStatementAlignment"/>
		<exclude name="Generic.Formatting.MultipleStatementAlignment"/>
		<!-- Sintassi breve degli array non usata, ma non è un problema da segnalare. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<!-- Elenchi brevi (effetti, transizioni, posizioni) scritti su una riga: è solo formattazione. -->
		<exclude name="WordPress.Arrays.ArrayDeclarationSpacing"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="kaosslider"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="kaosslider"/>
				<element value="KaosSlider"/>
			</property>
		</properties>
	</rule>

	<!-- La prova automatica gira con wp eval-file: le sue variabili non finiscono nello spazio globale del sito. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride.Prohibited">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>
