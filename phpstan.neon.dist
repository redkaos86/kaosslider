parameters:
	level: 5
	paths:
		- kaosslider.php
		- uninstall.php
		- includes
	excludePaths:
		# Estendono classi di Elementor e Divi, che non sono presenti durante l'analisi.
		- includes/integrations/class-kaosslider-elementor-widget.php
		- includes/integrations/class-kaosslider-divi-module.php
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	treatPhpDocTypesAsCertain: false
	ignoreErrors:
		-
			identifier: class.notFound
			paths:
				- includes/integrations/elementor.php
				- includes/integrations/divi.php
		# api_version è un intero in block.json; gli stub di WordPress lo dichiarano stringa.
		-
			identifier: argument.type
			path: includes/integrations/block.php
